<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window viewModel="@id('vm') @init('com.gestao.zk.userinterfaces.view.EspacoViewModel')" hflex="1" vflex="1" style="border: none;">
        <vlayout spacing="15px" hflex="1" vflex="1">
            <groupbox title="Cadastro / Edição de Espaços" style="padding: 10px;">
                <include src="~./zul/espacos/form.zul" />
            </groupbox>
            <groupbox title="Espaços Cadastrados" vflex="1" style="padding: 10px;">
                <include src="~./zul/espacos/list.zul" />
            </groupbox>
        </vlayout>
    </window>
</zk>
