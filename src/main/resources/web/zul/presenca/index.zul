<?xml version="1.0" encoding="UTF-8"?>
<zk xmlns="http://www.zkoss.org/2005/zul">
    <window viewModel="@id('vm') @init('com.gestao.zk.userinterfaces.view.PresencaViewModel')" hflex="1" vflex="1" style="border: none; background: transparent;">
        <vlayout spacing="15px" hflex="1" style="padding: 5px; overflow-x: hidden;">
            <groupbox title="Painel de Controle de Acesso" style="padding: 10px; border-radius: 6px;" hflex="1">
                <include src="~./zul/presenca/form.zul" />
            </groupbox>
            <groupbox title="Status de Ocupação dos Ambientes em Tempo Real" style="padding: 10px; border-radius: 6px;" hflex="1">
                <include src="~./zul/presenca/list.zul" />
            </groupbox>
        </vlayout>
    </window>
</zk>
